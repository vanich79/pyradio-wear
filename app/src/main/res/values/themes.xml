<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PyRadio" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
        Тема заглушки, которая ловит нажатие с плитки. Окна у неё нет вовсе:
        пользователь остаётся на плитке и ничего не замечает.
    -->
    <style name="Theme.PyRadio.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
