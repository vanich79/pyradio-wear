<?xml version="1.0" encoding="utf-8"?>
<!--
  Тридцать четыре станции из сорока четырёх в плейлисте PyRadio живут на http://.
  Android с API 28 режет такой трафик по умолчанию и делает это молча, на уровне
  сокета, — станция просто «не отвечает», без единой подсказки почему.

  Белый список доменов здесь не работает, и это не лень. Домены из stations.csv —
  это адреса .pls-файлов, а не потоков: somafm.com отдаёт внутри ice1.somafm.com,
  ice2.somafm.com и далее по списку узлов CDN, который меняется без нашего ведома.
  Перечислить можно только то, что известно заранее, а здесь заранее не известно
  ничего. Поэтому cleartext разрешён целиком.

  Цена решения честная: трафик радиопотоков идёт открытым и может быть подменён в
  недоверенной сети. Для публичного эфира, который и так слушают все желающие,
  это приемлемо; для чего-то приватного такой конфиг был бы недопустим.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
