# Сборка. `build/` без ведущего слэша — чтобы правило действовало на каждом
# уровне: каталоги сборки есть и у корня, и у app, и у каждого модуля core.
build/
.gradle/
.kotlin/

# Пути к SDK на конкретной машине.
local.properties

# IDE
*.iml
.idea/
.externalNativeBuild
.cxx
captures/

.DS_Store

# Ключ подписи и его пароль. Потеря ключа означает, что обновить уже
# установленное приложение будет нечем: Android принимает обновление только
# за той же подписью. Хранить его в репозитории — значит отдать чужим людям
# право выпускать обновления от вашего имени.
*.jks
*.keystore
*.password.txt

# Ключи подписи. Здесь их быть не должно — они живут вне репозитория, — но
# правило стоит на случай, если кто-то однажды положит их сюда по привычке.
keys/
*.jks
*.keystore
